# Copy to deploy/server.env on the server and set permissions to 600.
# This file is loaded only by the backend container.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Production must remain fail-closed behind Cloudflare Access.
OUR_KITCHEN_AUTH_MODE=cloudflare
OUR_KITCHEN_CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
OUR_KITCHEN_CLOUDFLARE_ACCESS_AUDIENCE=your-access-application-aud-tag
OUR_KITCHEN_ALLOWED_ORIGINS=http://127.0.0.1:8080
OUR_KITCHEN_HOUSEHOLD_NAME=Our Kitchen
