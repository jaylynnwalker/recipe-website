OUR_KITCHEN_DATABASE_URL=sqlite:///./data/our-kitchen.sqlite3
OUR_KITCHEN_MEDIA_ROOT=data/media
OUR_KITCHEN_AUTH_MODE=local
OUR_KITCHEN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OUR_KITCHEN_HOUSEHOLD_NAME=Our Kitchen
# Optional AI features. Keep the real key only in your untracked local .env.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna
# Production-only, when OUR_KITCHEN_AUTH_MODE=cloudflare:
# OUR_KITCHEN_CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# OUR_KITCHEN_CLOUDFLARE_ACCESS_AUDIENCE=your-access-application-aud-tag
